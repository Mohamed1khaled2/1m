# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Secret key (sb_secret_...) — للسيرفر بس. الموقع مابيكلمش Supabase من المتصفح خالص
SUPABASE_SERVICE_ROLE_KEY=

# كلمة سر صفحة الأدمن (/admin). خليها طويلة
ADMIN_PASSWORD=

# لينك الموقع (من غير / في الآخر) — بيتحط في صورة المعاينة
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# زرار "تابعني"
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@yourhandle

# اختياري: تجرّب كأننا في 2027 عشان صناديق الأرباع تفتح (للتصوير بس)
# APP_NOW=2027-07-15
